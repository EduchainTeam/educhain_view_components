<div class="container mx-auto mt-8">
  <%= render Educhain::Footer::Component.new(copyright:) do |footer|  %>
    <%= footer.with_logo(width:, path:, text:) %>
    <% items.each do |item| %>
      <% footer.with_item(
           width: item.width,
           key: item.key,
           links: item.links
         ) %>
    <% end %>
  <% end %>
</div>
