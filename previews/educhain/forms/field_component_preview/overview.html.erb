<div class="mb-8">
  <h6 class="text-gray-500 mb-3 mt-0">
    With just the label
  </h6>

  <%= render Educhain::Forms::Field::Component.new(
    label: "Greeting",
  ) do %>
    <%= render Educhain::Forms::Input::Component.new(value: "Hello world!") %>
  <% end %>
</div>
<div class="mb-8">
  <h6 class="text-gray-500 mb-3 mt-0">
    With hint,
    tip and error
  </h6>

  <%= render Educhain::Forms::Field::Component.new(
    label: "Greeting",
    hint: "A brief explanation",
    tip: "More in-detail information about this filed",
    error: "The second letter should be lowecase",
  ) do %>
    <%= render Educhain::Forms::Input::Component.new(value: "HEllo world!", error: "The second letter should be lowecase") %>
  <% end %>
</div>