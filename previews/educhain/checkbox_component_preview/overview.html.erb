<div class="flex ml-6 mt-3 space-x-4">
  <% sizes.each_key do |size| %>
    <div class="flex-col py-3 space-y-4">
      <div class="mb-4">
        size: :<%= size%>   
      </div>
      <div > 
      <%= render Educhain::Checkbox::Component.new(size: size.to_sym) %>
      <p>
        default
      </p>
      </div>
      <div> 
      <%= render Educhain::Checkbox::Component.new(checked: true) %>
      <p class="text-sm">
        checked: true
      </p>
      </div>
      <div > 
      <%= render Educhain::Checkbox::Component.new(disabled: true) %>
      <p class="text-sm">
        disabled: true
      </p>
      </div>
      <div>
      <%= render Educhain::Checkbox::Component.new(checked: true, disabled: true) %>
      <p class="text-sm">
        checked: true, disabled: true
      </p>
      </div>
    </div>
  <% end %>
</div>
