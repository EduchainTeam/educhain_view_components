<details <%= tag.attributes @attrs %> class="size-fit cursor-default">
  <summary
    class="text-black flex items-center"
    title="Меню пользователя"
  >
    <% if @avatar_url %>
      <!-- Profile photo-->
      <%= render Educhain::Image::Component.new(
        src: @avatar_url, 
        alt: 'Изображение профиля пользователя', 
        class: "rounded-full w-9 h-9 cursor-default"
      ) %>
    <% else %>
      <!-- Profile icon -->
      <span class="flex justify-center items-center bg-gray-200 rounded-full w-9 h-9 cursor-default select-none" aria-label="Перейти в ваш профиль">
        <%= render Educhain::Icon::Component.new(name: "user-3-line", width: 20, height: 20) %> 
      </span>
    <% end %>
  </summary>

  <div class="absolute w-[15rem] mt-2.5 p-3 border rounded-lg border-gray-100 bg-gray-50 z-10 right-0">
    <div class="flex flex-col gap-2 justify-center items-center pb-4">
      <% if @avatar_url %>
        <!-- Profile photo-->
        <%= render Educhain::Image::Component.new(
          src: @avatar_url, 
          alt: 'Изображение профиля пользователя', 
          class: "rounded-full w-16 h-16"
        ) %>
      <% else %>
        <!-- Profile icon -->
        <span class="flex justify-center items-center bg-gray-200 rounded-full w-16 h-16 cursor-pointer select-none" aria-label="Перейти в ваш профиль">
          <%= render Educhain::Icon::Component.new(name: "user-3-line", width: 35, height: 35) %> 
        </span>
      <% end %>

      <!-- Username-->
      <h1 class="text-2xl text-center font-medium w-full truncate">
        <%= @name %>
      </h1>
    </div>
    
    <!-- Links and Buttons for the menu -->
    <ul class="flex flex-col w-full gap-0.5">
      <% items.each do |item| %>
        <li>
          <%= render Educhain::Navbar::Item::Component.new(
            position: item[:position],
            type: item[:type],
            text: item[:text],
            href: item[:href]
          ) %>
        </li>
      <% end %>
    </ul>
  </div>
</details>
