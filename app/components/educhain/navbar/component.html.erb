<nav class="flex justify-between items-center gap-2.5 h-14 px-8 py-4 bg-gray-50" aria-label="Основная навигация">
  <div class="flex items-center gap-8">
    <!-- Menu -->
    <button class="cursor-pointer select-none" aria-label="Открыть меню">
      <%= icon_tag "menu-fill", class: "w-5 h-5" %>
    </button>

    <!-- Logo -->
    <% if @brand_logo_url %>
      <%= link_to "/", class: "flex justify-items-start items-center select-none" do %>
        <%= image_tag(@brand_logo_url, alt: "Logo", class: "h-6 w-auto") %>
      <% end %>
    <% end %>
  </div>

  <!-- Navbar Links -->
  <% if @nav_links.any? %>
    <ul class="hidden md:inline-flex justify-center gap-12">
      <% @nav_links.each do |link| %>
        <li>
          <%= render Educhain::Link::Component.new(
            text: link[:name], 
            href: link[:href], 
            scheme: :navbar
          ) %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <!-- User Section -->
  <div class="flex items-center gap-4">
    <% if @current_user %>
      <%= render Educhain::Navbar::UserMenu::Component.new(
            name: @current_user[:name]
          ) do |menu| %>
        <% @menu_items.each do |item| %>
          <% menu.with_item(label: item[:label], href: item[:href], button: item[:button]) %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Educhain::Button::Component.new(
        text: "Войти", 
        class: "px-6 bg-red-600 rounded-full"
      ) %>
    <% end %>
  </div>
</nav>
